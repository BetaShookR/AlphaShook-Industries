{
  "name": "alphashook-launcher",
  "productName": "AlphaShook Launcher",
  "version": "0.1.1",
  "description": "Launcher de escritorio de AlphaShook",
  "author": {
    "name": "AlphaShook Corporation",
    "email": "soporte@alphashook.local"
  },
  "homepage": "https://alphashook.onrender.com",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.electron.json && tsc -p tsconfig.json --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test test/*.test.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.10.2",
    "electron-builder": "26.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.alphashook.launcher",
    "productName": "AlphaShook Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "AlphaShook-Launcher-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "AlphaShook Corporation",
      "artifactName": "AlphaShook-Launcher-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://alphashook.onrender.com/v1/launcher/"
      }
    ]
  }
}
