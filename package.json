{
  "name": "alphashook",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @alphashook/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @alphashook/api db:generate",
    "db:migrate": "pnpm --filter @alphashook/api db:migrate",
    "catalog:import": "pnpm --filter @alphashook/api catalog:import",
    "user:role": "pnpm --filter @alphashook/api user:role",
    "dev:web": "pnpm --filter @alphashook/web dev"
  }
}
